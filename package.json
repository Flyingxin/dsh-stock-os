{
  "name": "dsh-stock-os",
  "version": "0.4.0",
  "description": "Investment decision ledger for DeepSeek Harness: written rules before trades, one record per action, with a sidebar workbench.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Flyingxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flyingxin/dsh-stock-os.git"
  },
  "homepage": "https://github.com/Flyingxin/dsh-stock-os#readme",
  "bugs": {
    "url": "https://github.com/Flyingxin/dsh-stock-os/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "investment",
    "stock",
    "checklist"
  ],
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "lab",
    "cordis.patch.yml",
    "playbooks",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
